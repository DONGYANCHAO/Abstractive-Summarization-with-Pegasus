[run]
source = .
branch = True
omit =
    venv/*
    tests/*
    __pycache__/*
    .pytest_cache/*
    htmlcov/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    pass

show_missing = True
skip_covered = False

[html]
directory = htmlcov
